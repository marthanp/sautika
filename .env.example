# ==============================================================================
# SAUTIKA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local or .env. Never commit real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (MongoDB Atlas)
# Tip: Ensure your client IP address is added in MongoDB Atlas -> Security -> Network Access
# (use 0.0.0.0/0 to allow connections from any development environment).
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Object Storage (Curriculum & Media Assets)
# Note:
# - R2_ACCESS_KEY_ID must be the 32-character hexadecimal Access Key ID (not the Token string).
# - R2_SECRET_ACCESS_KEY must be the 64-character hexadecimal Secret Access Key.
# ------------------------------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-32-character-hex-access-key-id
R2_SECRET_ACCESS_KEY=your-64-character-hex-secret-access-key
R2_BUCKET_NAME=sautika-media
R2_PUBLIC_URL=https://pub-<id>.r2.dev

# ------------------------------------------------------------------------------
# 3. Authentication (Clerk)
# Obtain from Clerk Dashboard -> API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# ------------------------------------------------------------------------------
# 4. Sunbird AI (East African Speech-to-Text & Text-to-Speech)
# Obtain API token from https://sunbird.ai
# ------------------------------------------------------------------------------
SUNBIRD_API_KEY=your-sunbird-api-token
SUNBIRD_API_URL=https://api.sunbird.ai

# ------------------------------------------------------------------------------
# 5. Document OCR Engines (OCR.Space Cloud & MCP Integration)
# Obtain free or paid API key from https://ocr.space/ocrapi
# ------------------------------------------------------------------------------
OCR_SPACE_API_KEY=your-ocr-space-api-key
OCR_SPACE_API_KEY_FALLBACK=your-backup-ocr-space-api-key

# ------------------------------------------------------------------------------
# 6. Multi-Provider AI LLM Engine (Study Summaries, Explanations & Quizzes)
# The application automatically routes requests to whichever provider key is populated.
# Supported aliases:
# - GEMINI_API_KEY or GOOGLE_API_KEY
# - NVIDIA_NIM_API_KEY or NVIDIA_API_KEY
# - KIMI_API_KEY or MOONSHOT_API_KEY
# - ZAI_API_KEY or ZHIPU_API_KEY
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
FIREWORKS_API_KEY=
NVIDIA_NIM_API_KEY=
KIMI_API_KEY=
ZAI_API_KEY=
COHERE_API_KEY=

# Model overrides. Leave blank to use the defaults the code ships with
# (Gemini: gemini-3.8-flash, Groq: llama-3.3-70b-versatile).
GEMINI_MODEL=
GROQ_MODEL=

# Anthropic Claude. Two tiers: `fast` answers chat, quizzes and flashcards;
# `deep` writes reports, audio scripts, mind maps and slide decks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_DEEP=claude-sonnet-5-5

# Hedging and budget for the LLM router. If the first provider has not sent a
# token within LLM_HEDGE_MS, a second starts in parallel and the slower one is
# aborted. No attempt is given more time than the budget has left, so a route
# cannot run past its maxDuration.
LLM_HEDGE_MS=2500
LLM_TOTAL_BUDGET_MS=50000
# Comma-separated provider order per tier, overriding the defaults.
LLM_ORDER_FAST=
LLM_ORDER_DEEP=

# ------------------------------------------------------------------------------
# 6b. Speech recognition (AssemblyAI)
# AssemblyAI is the ears for English; Sunbird handles the Ugandan languages and
# remains the translation and voice layer for every language.
# ------------------------------------------------------------------------------
ASSEMBLYAI_API_KEY=
# Below this language confidence, the audio goes to Sunbird instead.
ASSEMBLYAI_EN_CONFIDENCE=0.80
# Priority-ordered model list. Blank uses the current default,
# ["universal-3-5-pro", "universal-2"].
ASSEMBLYAI_SPEECH_MODELS=
# A shared secret for /api/webhooks/assemblyai. Set it and NEXT_PUBLIC_APP_URL
# to let a long recording finish through a webhook instead of a polling loop.
ASSEMBLYAI_WEBHOOK_SECRET=
# The public origin of this deployment, used to build that webhook URL.
NEXT_PUBLIC_APP_URL=

# ------------------------------------------------------------------------------
# 6c. Background jobs (Inngest)
# Source ingestion, Studio generation and the nightly backup. Leave blank and
# the same pipelines run inline, which is fine for small sources but will not
# survive a 60-page PDF. Locally: `npx inngest-cli@latest dev` with INNGEST_DEV=1.
# ------------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ------------------------------------------------------------------------------
# 6d. Retrieval embeddings
# `gemini` (the default) uses GEMINI_API_KEY above. `none` switches embeddings
# off and retrieval falls back to keyword search.
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
# Override the embedding model. Must match the dimensions in
# database/vector-index.json if you change it.
GEMINI_EMBEDDING_MODEL=

# ------------------------------------------------------------------------------
# 7. Translation quality
# The translation router tries Sunbird AI, Google Cloud Translation and an LLM,
# in the order that suits the language pair.
# ------------------------------------------------------------------------------
# Enable the Cloud Translation API in Google Cloud, then restrict this key to
# that one API before using it.
GOOGLE_TRANSLATE_API_KEY=
# Run English results through the LLM as a copy editor.
TRANSLATION_ENGLISH_POLISH=false
# Force a provider order, for example: google,sunbird,llm
TRANSLATION_PROVIDER_ORDER=

# ------------------------------------------------------------------------------
# 8. Operations and security
# Bearer secret for the backup/sync endpoints (/api/sync). Either name works.
# ------------------------------------------------------------------------------
SYNC_SECRET=
CRON_SECRET=

# ------------------------------------------------------------------------------
# 9. Remote MCP endpoint (/api/mcp)
# Without a token the endpoint still serves the five read-only curriculum tools.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
MCP_API_TOKEN=
# Comma-separated origins allowed to call /api/mcp from a browser.
MCP_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 6e. Web sources (optional)
# Powers "Search the web for new sources" in the Add sources dialog. With
# neither key set the feature is hidden rather than shown broken. Whichever is
# present is used; Brave is tried first.
# ------------------------------------------------------------------------------
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
