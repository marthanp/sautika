# ==============================================================================
# SAUTIKA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local or .env. Never commit real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (MongoDB Atlas)
# Tip: Ensure your client IP address is added in MongoDB Atlas -> Security -> Network Access
# (use 0.0.0.0/0 to allow connections from any development environment).
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Object Storage (Curriculum & Media Assets)
# Note:
# - R2_ACCESS_KEY_ID must be the 32-character hexadecimal Access Key ID (not the Token string).
# - R2_SECRET_ACCESS_KEY must be the 64-character hexadecimal Secret Access Key.
# ------------------------------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-32-character-hex-access-key-id
R2_SECRET_ACCESS_KEY=your-64-character-hex-secret-access-key
R2_BUCKET_NAME=sautika-media
R2_PUBLIC_URL=https://pub-<id>.r2.dev

# ------------------------------------------------------------------------------
# 3. Authentication (Clerk)
# Obtain from Clerk Dashboard -> API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# ------------------------------------------------------------------------------
# 4. Sunbird AI (East African Speech-to-Text & Text-to-Speech)
# Obtain API token from https://sunbird.ai
# ------------------------------------------------------------------------------
SUNBIRD_API_KEY=your-sunbird-api-token
SUNBIRD_API_URL=https://api.sunbird.ai

# ------------------------------------------------------------------------------
# 5. Document OCR Engines (OCR.Space Cloud & MCP Integration)
# Obtain free or paid API key from https://ocr.space/ocrapi
# ------------------------------------------------------------------------------
OCR_SPACE_API_KEY=your-ocr-space-api-key
OCR_SPACE_API_KEY_FALLBACK=your-backup-ocr-space-api-key

# ------------------------------------------------------------------------------
# 6. Multi-Provider AI LLM Engine (Study Summaries, Explanations & Quizzes)
# The application automatically routes requests to whichever provider key is populated.
# Supported aliases:
# - GEMINI_API_KEY or GOOGLE_API_KEY
# - NVIDIA_NIM_API_KEY or NVIDIA_API_KEY
# - KIMI_API_KEY or MOONSHOT_API_KEY
# - ZAI_API_KEY or ZHIPU_API_KEY
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
FIREWORKS_API_KEY=
NVIDIA_NIM_API_KEY=
KIMI_API_KEY=
ZAI_API_KEY=
COHERE_API_KEY=
