# Copy to .env.local and fill in. Never commit .env.local.

# --- Claude (notebook answers, summaries, practice lessons) ---
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Sunbird AI (speech-to-text and text-to-speech for Luganda, Acholi, Ateso, Runyankole, Swahili) ---
# Get a token: https://sunbird.ai  (check their API docs for the current base URL and paths)
SUNBIRD_API_KEY=your-sunbird-api-token
SUNBIRD_API_URL=https://api.sunbird.ai

# --- Supabase (next phase: cloud sync + pgvector curriculum search; not used by the code yet) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
