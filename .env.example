# Copy to .env.local and fill in. Never commit .env.local.

# --- Clerk authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key

# --- Claude (notebook answers, summaries, practice lessons) ---
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Sunbird AI (speech-to-text and text-to-speech for Luganda, Acholi, Ateso, Runyankole, Swahili) ---
# Get a token: https://sunbird.ai  (check their API docs for the current base URL and paths)
SUNBIRD_API_KEY=your-sunbird-api-token
SUNBIRD_API_URL=https://api.sunbird.ai

# --- MongoDB (learner profiles, learning progress, settings and notebook) ---
# Create a database user and allow your IP in MongoDB Atlas, then paste its URI here.
# Run the schema with: mongosh "<MONGODB_URI>" --file .\database\sautika.mongodb.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# --- Supabase (next phase: cloud sync + pgvector curriculum search; not used by the code yet) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
