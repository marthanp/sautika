# ==============================================================================
# SAUTIKA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local or .env. Never commit production credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Object Storage (Curriculum & Media Assets)
# ------------------------------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sautika-media
R2_PUBLIC_URL=https://pub-<id>.r2.dev

# ------------------------------------------------------------------------------
# 3. Authentication (Clerk)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# ------------------------------------------------------------------------------
# 4. Sunbird AI (East African Speech-to-Text & Text-to-Speech)
# ------------------------------------------------------------------------------
SUNBIRD_API_KEY=your-sunbird-api-token
SUNBIRD_API_URL=https://api.sunbird.ai

# ------------------------------------------------------------------------------
# 5. Document OCR Engines (OCR.Space Cloud & MCP Integration)
# ------------------------------------------------------------------------------
OCR_SPACE_API_KEY=your-ocr-space-api-key
OCR_SPACE_API_KEY_FALLBACK=your-backup-ocr-space-api-key

# ------------------------------------------------------------------------------
# 6. Multi-Provider AI LLM Engine (Study Summaries, Explanations & Quizzes)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
FIREWORKS_API_KEY=
NVIDIA_NIM_API_KEY=
KIMI_API_KEY=
ZAI_API_KEY=
COHERE_API_KEY=
